# Managed by scripts/add-site.sh -- @@HOSTNAME@@ (stage 1: HTTP only, waiting for certificate)
# Replaced by the HTTPS version once the certificate has been issued.
server {
    listen 80;
    listen [::]:80;
    server_name @@HOSTNAME@@;

    include /etc/nginx/snippets/acme-challenge.conf;

    location / {
        return 503;
    }
}
