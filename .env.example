# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# Base domain. Sites are served as <subdomain>.<DOMAIN>
DOMAIN=example.com

# Contact e-mail for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=admin@example.com

# Name of the external Docker network shared with the proxied containers
# (create once with: docker network create proxy)
PROXY_NETWORK=proxy

# Set to 1 to use the Let's Encrypt staging CA while testing (avoids rate limits)
LETSENCRYPT_STAGING=0
